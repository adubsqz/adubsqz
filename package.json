 {
  "name": "adubsqz-photography",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "lint:md": "npx markdownlint-cli2 \"**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}\" \"!**/*.code-search\" \"!**/bower_components\" \"!**/node_modules\" \"!**/.git\" \"!**/vendor\"",
    "lint:md:docs": "npx markdownlint-cli2 --config .markdownlint-docs.jsonc \"README.md\" \"SETUP.md\" \"scripts/**/*.md\" \".cursor/docs/**/*.md\"",
    "verify:gallery-manifest": "node scripts/verify-gallery-manifest.mjs",
    "gallery:classify": "node scripts/classify-still-life.mjs",
    "prepare:gallery": "node scripts/prepare-gallery-assets.mjs",
    "import:gallery": "node scripts/process-gallery-import.mjs",
    "curate": "node scripts/curate.mjs",
    "process:originals": "node scripts/process-originals-batch.mjs",
    "review:semantic-categories": "node scripts/review-semantic-categories.mjs",
    "build": "vite build && node scripts/prune-dist-gallery.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node playwright-cli.mjs test",
    "test:e2e:ui": "node playwright-cli.mjs test --ui",
    "test:e2e:headed": "node playwright-cli.mjs test --headed",
    "playwright:install": "node playwright-cli.mjs install chromium",
    "sync:gallery-ignore": "node sync-gallery-ignore.mjs",
    "check:gallery-ignore": "node sync-gallery-ignore.mjs --check",
    "optimize:images": "node scripts/optimize-images-example.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.1.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@xenova/transformers": "^2.0.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  }
}
